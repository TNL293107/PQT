# ===========================================================================
# Personal Quantitative Trading & Market Intelligence Terminal
# Multi-stack .gitignore: .NET / Node / Python / C++ / Docker
#
# Guiding rules:
#   * Never commit secrets or credentials.
#   * Never commit build output.
#   * Never commit bulk market data (see data/README.md for the data policy).
#   * DO keep documentation, schemas and small deterministic fixtures.
# ===========================================================================

# ---------------------------------------------------------------------------
# Secrets and credentials  (highest priority — keep this block first)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
credentials/
secrets/
secrets.json
appsettings.Local.json
appsettings.*.Local.json
.npmrc.local
.pgpass

# ---------------------------------------------------------------------------
# .NET
# ---------------------------------------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
TestResults/
[Tt]est[Rr]esult*/
BenchmarkDotNet.Artifacts/
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
.nuget/
msbuild.log
msbuild.err
msbuild.wrn
coverage.cobertura.xml
coverage.opencover.xml
*.coverage
*.coveragexml

