# VS Code: ignore local machine state, but allow intentionally shared config.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# Local data
#
# NOTE: the data/ directory itself is tracked. Only bulk / derived / vendor
# payloads are ignored. data/README.md and data/schemas/ stay in Git.
# ---------------------------------------------------------------------------
data/raw/
data/cache/
data/tmp/
data/interim/
data/external/
datasets/raw/
datasets/cache/
datasets/tmp/
*.csv.gz
*.parquet
*.feather
*.arrow
*.h5
*.hdf5

# ---------------------------------------------------------------------------
# Local databases
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
pgdata/

