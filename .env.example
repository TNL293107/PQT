# ===========================================================================
# Personal Quantitative Trading & Market Intelligence Terminal
# Example environment file — SAFE TO COMMIT.
#
# Usage:
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   then edit .env with real local values.
#
# .env is git-ignored. NEVER commit a populated .env.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=Development
LOG_LEVEL=Information

# ---------------------------------------------------------------------------
# PostgreSQL
#
# POSTGRES_HOST=postgres      -> value used by containers on the compose network
# POSTGRES_HOST=localhost     -> value used when running the API on the host
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=personal_quant
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=CHANGE_ME

# Port exposed on the host machine for direct psql / GUI access.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
API_PORT=8080
FRONTEND_PORT=3000

# Origins allowed to call the API from a browser (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL the frontend uses to reach the API from the user's browser.
VITE_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Market data ingestion
#
# No source is registered until one is named here. A deployment with none
# ingests nothing and records skipped runs saying so, which is deliberate:
# silently reading whatever sits in a conventional directory would be worse.
#
# The file source reads CSV exports laid out as <interval>/<TICKER>.csv.
# See data/schemas/market-data-csv.md for the format, and
# data/fixtures/market-data for a synthetic example.
# ---------------------------------------------------------------------------
MarketData__FileProviderDirectory=

# The file instrument source reads a CSV symbol list. It is what populates the
# instrument master from a provider rather than from the development seed.
# See data/schemas/instrument-csv.md for the format, and
# data/fixtures/instruments.csv for a synthetic example.
MarketData__InstrumentListPath=

# Retry, timeout and rate-limit policy. The defaults in appsettings.json are
# sensible for a single-process nightly run; raise the call spacing before
# backfilling a universe against a metered provider.
# MarketData__MinimumCallSpacingMilliseconds=200
# MarketData__InitialBackfillDays=365

# ---------------------------------------------------------------------------
# External providers — PLANNED.
#
# Leave blank. Every provider must be reviewed against the data policy in
# docs/architecture/data-policy.md before a key is issued or data is stored.
# The file source above needs no key and is what the pipeline is proved
# against.
# ---------------------------------------------------------------------------
MARKET_DATA_API_KEY=
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Broker — PLANNED, not used in Phase 0.
#
# LIVE_TRADING_ENABLED MUST remain false. No order routing exists in this
# repository, and this flag is the deliberate safety default for every phase
# before Phase 14.
# ---------------------------------------------------------------------------
BROKER_API_KEY=
BROKER_API_SECRET=
LIVE_TRADING_ENABLED=false
