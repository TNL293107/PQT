# ===========================================================================
# Personal Quantitative Trading & Market Intelligence Terminal
# Example environment file — SAFE TO COMMIT.
#
# Usage:
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   then edit .env with real local values.
#
# .env is git-ignored. NEVER commit a populated .env.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=Development
LOG_LEVEL=Information

# ---------------------------------------------------------------------------
# PostgreSQL
#
# POSTGRES_HOST=postgres      -> value used by containers on the compose network
# POSTGRES_HOST=localhost     -> value used when running the API on the host
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=personal_quant
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=CHANGE_ME

# Port exposed on the host machine for direct psql / GUI access.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
API_PORT=8080
FRONTEND_PORT=3000

# Origins allowed to call the API from a browser (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL the frontend uses to reach the API from the user's browser.
VITE_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Market data ingestion
#
# No source is registered until one is named here. A deployment with none
# ingests nothing and records skipped runs saying so, which is deliberate:
# silently reading whatever sits in a conventional directory would be worse.
#
# The file source reads CSV exports laid out as <interval>/<TICKER>.csv.
# See data/schemas/market-data-csv.md for the format, and
# data/fixtures/market-data for a synthetic example.
# ---------------------------------------------------------------------------
MarketData__FileProviderDirectory=

# The file instrument source reads a CSV symbol list. It is what populates the
# instrument master from a provider rather than from the development seed.
# See data/schemas/instrument-csv.md for the format, and
# data/fixtures/instruments.csv for a synthetic example.
MarketData__InstrumentListPath=

# The trading calendar. Without it, completeness cannot be measured: every
# public holiday looks exactly like a failed ingestion run. Nothing is seeded
# in its place, because Vietnam's calendar cannot be derived — Tet is lunar and
# substitute days are set by annual decree.
# See data/schemas/trading-calendar-csv.md for the format.
MarketData__TradingCalendarPath=

# The corporate action source. Without it, prices are read exactly as they were
# printed, which is silently wrong across every split, dividend and rights
# issue — a chart that halves overnight with nothing to say why. Nothing is
# seeded in its place, because an invented action rescales real prices.
# See data/schemas/corporate-action-csv.md for the format, and
# data/fixtures/corporate-actions.csv for a synthetic example.
MarketData__CorporateActionPath=

# Retry, timeout and rate-limit policy. The defaults in appsettings.json are
# sensible for a single-process nightly run; raise the call spacing before
# backfilling a universe against a metered provider.
# MarketData__MinimumCallSpacingMilliseconds=200
# MarketData__InitialBackfillDays=365

# ---------------------------------------------------------------------------
# Running the pipelines
#
# Both are OFF by default: starting the API should not begin reading an
# external source. Turn them on once you have decided which source you read
# and how often you may.
#
# MARKET_DATA_IMPORT_ON_STARTUP runs the trading calendar and instrument
# imports once, at start-up. Both are additive and idempotent, so it is safe
# to leave on.
#
# MARKET_DATA_INGEST_ON_SCHEDULE ingests the listed universe on a timer. There
# is still no HTTP trigger — a request that causes outbound calls to a
# rate-limited third party waits for the authentication in Phase 18.
#
# Under Docker Compose these default to the tracked fixtures. The calendar is
# left unset on purpose: the fixture one is knowingly incomplete, and importing
# it would make completeness report real holidays as missing sessions.
# ---------------------------------------------------------------------------
MARKET_DATA_IMPORT_ON_STARTUP=false
MARKET_DATA_INGEST_ON_SCHEDULE=false
MARKET_DATA_INGESTION_PERIOD_MINUTES=60

# Paths inside the backend container, which mounts ./data read-only at /app/data.
MARKET_DATA_INSTRUMENT_LIST=/app/data/fixtures/instruments.csv
MARKET_DATA_BAR_DIRECTORY=/app/data/fixtures/market-data
MARKET_DATA_CALENDAR=

# The universe source is a directory holding universes.csv and
# universe-memberships.csv. The fixture sets are synthetic and state no real
# index membership: VN30's history has to be sourced from published review
# notices, and seeding today's constituents to stand in for earlier years is
# the survivorship bias the universe model exists to remove.
MARKET_DATA_UNIVERSES=/app/data/fixtures/universes

# ---------------------------------------------------------------------------
# External providers — PLANNED.
#
# Leave blank. Every provider must be reviewed against the data policy in
# docs/architecture/data-policy.md before a key is issued or data is stored.
# The file source above needs no key and is what the pipeline is proved
# against.
# ---------------------------------------------------------------------------
MARKET_DATA_API_KEY=
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Broker — PLANNED, not used in Phase 0.
#
# LIVE_TRADING_ENABLED MUST remain false. No order routing exists in this
# repository, and this flag is the deliberate safety default for every phase
# before Phase 14.
# ---------------------------------------------------------------------------
BROKER_API_KEY=
BROKER_API_SECRET=
LIVE_TRADING_ENABLED=false
