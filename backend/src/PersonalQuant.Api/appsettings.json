{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "// NOTE": "No credential appears in this file. Host, database, user and password are supplied by the environment (Postgres__Host, Postgres__Password, ...). See .env.example.",

  "Postgres": {
    "Port": 5432,
    "CommandTimeoutSeconds": 30,
    "ApplyMigrationsOnStartup": false,
    "SeedReferenceDataOnStartup": false
  },

  "Redis": {
    "Port": 6379,
    "Database": 0,
    "ConnectTimeoutMilliseconds": 5000
  },

  "MarketData": {
    "MaxAttempts": 3,
    "InitialBackoffMilliseconds": 500,
    "BackoffMultiplier": 2.0,
    "MaxBackoffMilliseconds": 30000,
    "ProviderTimeoutSeconds": 30,
    "MinimumCallSpacingMilliseconds": 200,
    "InitialBackfillDays": 365,
    "FileProviderDirectory": ""
  },

  "Cors": {
    "AllowedOrigins": ""
  }
}
