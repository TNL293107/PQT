# ---------------------------------------------------------------------------
# Line ending normalization
#
# The repository is developed on Windows and built/run inside Linux containers
# and Linux CI runners. Everything is stored in Git with LF so that the two
# environments never disagree about file contents.
# ---------------------------------------------------------------------------

# Default: let Git detect text files and normalize them to LF in the repository.
* text=auto eol=lf

# --- .NET ------------------------------------------------------------------
*.cs        text eol=lf diff=csharp
*.csproj    text eol=lf
*.fsproj    text eol=lf
*.vbproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sln       text eol=lf
*.slnx      text eol=lf
*.editorconfig text eol=lf

# --- Web / Node ------------------------------------------------------------
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# --- Python ----------------------------------------------------------------
*.py        text eol=lf diff=python
*.pyi       text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf

# --- C / C++ ---------------------------------------------------------------
*.c         text eol=lf diff=cpp
*.cc        text eol=lf diff=cpp
*.cpp       text eol=lf diff=cpp
*.cxx       text eol=lf diff=cpp
*.h         text eol=lf diff=cpp
*.hh        text eol=lf diff=cpp
*.hpp       text eol=lf diff=cpp
*.ixx       text eol=lf diff=cpp
CMakeLists.txt text eol=lf
*.cmake     text eol=lf

# --- Config, docs, infrastructure -----------------------------------------
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf diff=markdown
*.sh        text eol=lf
*.bash      text eol=lf
*.sql       text eol=lf
*.env       text eol=lf
.env.example text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# --- Windows-only scripts must keep CRLF ----------------------------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# --- Binary: never normalize ----------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.dll       binary
*.exe       binary
*.so        binary
*.dylib     binary
*.a         binary
*.lib       binary
*.pdb       binary
*.parquet   binary
*.feather   binary
*.arrow     binary
*.gguf      binary
*.safetensors binary

# --- Linguist / diff hints -------------------------------------------------
docs/**            linguist-documentation
*.lock             -diff
package-lock.json  -diff linguist-generated
